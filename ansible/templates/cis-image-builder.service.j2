# MANAGED BY ANSIBLE (deploy-platform.yml) — do not edit on the box.
[Unit]
Description=CIS Image Builder (RHEL10-CIS -> Tencent TKE hardened images)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory={{ app_dir }}/backend

# ── Configuration ─────────────────────────────────────────────────────────────
# Shared API token. Empty disables auth — keep it set for the public CLB.
Environment=CIS_AUTH_TOKEN={{ cis_auth_token }}

# Persistent app state OUTSIDE the repo so redeploys never wipe build history,
# saved selections, or validation history.
Environment=CIS_STORE_PATH={{ state_dir }}/builds_store.json
Environment=CIS_SELECTIONS_PATH={{ state_dir }}/saved_selections.json
Environment=CIS_VALIDATIONS_PATH={{ state_dir }}/validations_store.json

# Pipeline paths on the builder.
Environment=CIS_PIPELINE_DIR={{ pipeline_dir }}
Environment=CIS_PACKER_DIR={{ pipeline_dir }}/packer
Environment=CIS_GROUP_VARS_PATH={{ pipeline_dir }}/ansible/group_vars/all.yml
Environment=CIS_BUILD_LOG_DIR={{ pipeline_dir }}/logs

# Base/source image id — never recorded as a build output or deletable.
Environment=CIS_BASE_IMAGE_ID={{ cis_base_image_id }}

# Region used for image deletion / validation via tccli.
Environment=TENCENTCLOUD_REGION={{ tencent_region }}
# Disable HashiCorp checkpoint calls from packer (no outbound version pings).
Environment=CHECKPOINT_DISABLE=1

ExecStart=/usr/bin/env python3 -m uvicorn app:app --host 0.0.0.0 --port {{ app_port }}

Restart=on-failure
RestartSec=3
TimeoutStopSec=30

# ── Service hardening (systemd sandbox) ───────────────────────────────────────
# The app runs as root because it shells out to packer/tccli/ansible and reads
# the CAM instance-metadata creds. We keep root but lock down the sandbox so a
# compromise of the app has limited reach on the host.

# No privilege escalation beyond what the unit already has.
NoNewPrivileges=true

# Read-only root filesystem; only the paths below are writable. /root is kept
# writable because packer stores its plugin cache under root's home ($HOME); the
# pipeline, app, and state dirs are where the app + packer write artifacts.
ProtectSystem=strict
ReadWritePaths={{ state_dir }} {{ pipeline_dir }} {{ app_dir }} /root

# Private, ephemeral /tmp. ProtectHome is left off because packer needs /root.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

# Restrict kernel/namespace surface.
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RemoveIPC=true

# Only allow the address families the app + tccli/packer need.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Syscall allow-listing: common service set (covers python/network/exec).
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
