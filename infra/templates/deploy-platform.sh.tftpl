#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# deploy-platform.sh  (executed on the builder via TAT — no SSH)
#
# Bootstraps Ansible if needed, pulls the repo so the playbook is current, then
# runs deploy-platform.yml locally to (re)deploy the cis-image-builder app.
#
# Rendered by: cis-image-builder/infra/deploy.tf (templatefile).
# The auth token is fetched from SSM at runtime, never embedded here.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail
export HOME=/root
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"

REPO_URL="${repo_url}"
DEPLOY_REF="${deploy_ref}"
APP_DIR="${app_dir}"
RUN_ID="${deploy_run_id}"   # changes to force re-run; not otherwise used

# Auth token is fetched from SSM AT DEPLOY TIME (not embedded in this command).
# tccli authenticates via the builder's CAM role: pull temporary creds from the
# instance metadata service and export them (same pattern the app uses).
TOKEN_SECRET_NAME="${token_secret_name}"
TOKEN_SECRET_VERSION="${token_secret_version}"
REGION="${tencent_region}"
META_BASE="http://metadata.tencentyun.com/latest/meta-data/cam/security-credentials/"

echo "fetching CAM-role credentials from instance metadata"
ROLE="$(curl -fsS --max-time 5 "$META_BASE")"
if [ -z "$ROLE" ]; then
  echo "ERROR: no CAM role from metadata — is a role attached to this CVM?" >&2
  exit 1
fi
CREDS="$(curl -fsS --max-time 5 "$META_BASE$ROLE")"
export TENCENTCLOUD_SECRET_ID="$(echo "$CREDS"  | python3 -c 'import sys,json;print(json.load(sys.stdin)["TmpSecretId"])')"
export TENCENTCLOUD_SECRET_KEY="$(echo "$CREDS" | python3 -c 'import sys,json;print(json.load(sys.stdin)["TmpSecretKey"])')"
export TENCENTCLOUD_TOKEN="$(echo "$CREDS"      | python3 -c 'import sys,json;print(json.load(sys.stdin)["Token"])')"
export TENCENTCLOUD_SECURITY_TOKEN="$TENCENTCLOUD_TOKEN"
export TENCENTCLOUD_REGION="$REGION"

echo "fetching app token from SSM ($TOKEN_SECRET_NAME:$TOKEN_SECRET_VERSION)"
SSM_OUT="$(tccli ssm GetSecretValue \
  --region "$REGION" \
  --SecretName "$TOKEN_SECRET_NAME" \
  --VersionId "$TOKEN_SECRET_VERSION" \
  --output json 2>&1)" || {
    echo "ERROR: tccli GetSecretValue failed:" >&2
    echo "$SSM_OUT" >&2
    exit 1
  }
CIS_AUTH_TOKEN="$(echo "$SSM_OUT" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("SecretString",""))' 2>/dev/null || true)"
if [ -z "$CIS_AUTH_TOKEN" ]; then
  echo "ERROR: empty token from SSM. Raw tccli output was:" >&2
  echo "$SSM_OUT" >&2
  exit 1
fi

echo "=== deploy cis-image-builder (ref=$DEPLOY_REF run=$RUN_ID) $(date) ==="

# Ensure git + an ansible-playbook are available. The builder image was built
# with ansible-core under python3.12; fall back to installing if missing.
command -v git >/dev/null 2>&1 || dnf install -y git

if ! command -v ansible-playbook >/dev/null 2>&1; then
  echo "ansible-playbook not found — installing ansible-core via python3.12"
  python3.12 -m pip install --upgrade pip
  python3.12 -m pip install "ansible-core>=2.16,<2.17"
fi

# Get the repo onto the box at the requested ref. Three cases:
#   1. already a git repo  -> fetch + hard reset
#   2. dir exists, NOT git -> adopt it in place (git init + remote + reset)
#   3. dir absent          -> plain clone
# Case 2 handles a pre-existing hand-copied /root/cis-image-builder.
if [ -d "$APP_DIR/.git" ]; then
  echo "repo present — fetching"
  git -C "$APP_DIR" remote set-url origin "$REPO_URL" 2>/dev/null || git -C "$APP_DIR" remote add origin "$REPO_URL"
  git -C "$APP_DIR" fetch --all --prune
  git -C "$APP_DIR" checkout -f "$DEPLOY_REF"
  git -C "$APP_DIR" reset --hard "origin/$DEPLOY_REF" 2>/dev/null || git -C "$APP_DIR" reset --hard "$DEPLOY_REF"
elif [ -d "$APP_DIR" ]; then
  echo "dir exists but is not a git repo — adopting in place"
  git -C "$APP_DIR" init
  git -C "$APP_DIR" remote add origin "$REPO_URL" 2>/dev/null || git -C "$APP_DIR" remote set-url origin "$REPO_URL"
  git -C "$APP_DIR" fetch --all --prune
  git -C "$APP_DIR" checkout -f "$DEPLOY_REF"
  git -C "$APP_DIR" reset --hard "origin/$DEPLOY_REF"
else
  echo "cloning fresh"
  git clone "$REPO_URL" "$APP_DIR"
  git -C "$APP_DIR" checkout -f "$DEPLOY_REF"
fi

cd "$APP_DIR/ansible"

ansible-playbook deploy-platform.yml \
  -e "repo_url=$REPO_URL" \
  -e "deploy_ref=$DEPLOY_REF" \
  -e "app_dir=$APP_DIR" \
  -e "app_port=${app_port}" \
  -e "cis_base_image_id=${cis_base_image_id}" \
  -e "tencent_region=${tencent_region}" \
  -e "cis_auth_token=$CIS_AUTH_TOKEN"

echo "=== deploy complete $(date) ==="
