# ─────────────────────────────────────────────────────────────────────────────
# APP AUTH TOKEN — generated by Terraform, stored in SSM, fetched at deploy time.
#
# Replaces the hand-set, in-state CIS_AUTH_TOKEN. Terraform generates a strong
# random token and stores it in SSM. The deploy playbook fetches it from SSM on
# the builder (which has the CAM ssm:GetSecretValue permission) and writes it
# into the systemd unit — so the token is NOT embedded in the TAT command
# content.
#
# ROTATION: bump var.token_version (e.g. "v1" -> "v2"). The random_password is
# keyed to that version, so a new value is generated and stored as a new SSM
# version; the next deploy fetches it and restarts the app with the new token.
# ─────────────────────────────────────────────────────────────────────────────

resource "random_password" "auth_token" {
  length  = 48
  special = false # keep it URL/header-safe (letters + digits only)

  keepers = {
    # Regenerate only when the version changes (intentional rotation).
    version = var.token_version
  }
}

module "auth_token_secret" {
  source = "../modules/ssm-secret"

  secret_name   = "${local.name_prefix}-app-auth-token"
  secret_string = random_password.auth_token.result
  version_id    = var.token_version
  description   = "cis-image-builder app API token (CIS_AUTH_TOKEN). Rotated by bumping token_version."

  recovery_window_in_days = 0
  tags                    = local.common_tags
}
