# ─────────────────────────────────────────────────────────────────────────────
# ssh-keypair module — inputs
# ─────────────────────────────────────────────────────────────────────────────

variable "key_name" {
  description = "Name for the Tencent CVM key pair (letters, numbers, underscore)."
  type        = string
}

variable "secret_name" {
  description = "Name of the SSM secret that stores the PEM private key. Must be unique per region (letters, numbers, '_' and '-'; first char a letter or number)."
  type        = string
}

variable "algorithm" {
  description = "Key algorithm: RSA or ED25519."
  type        = string
  default     = "RSA"

  validation {
    condition     = contains(["RSA", "ED25519"], var.algorithm)
    error_message = "algorithm must be RSA or ED25519."
  }
}

variable "rsa_bits" {
  description = "Key size in bits when algorithm = RSA (ignored for ED25519)."
  type        = number
  default     = 4096
}

variable "secret_description" {
  description = "Human-readable description stored on the SSM secret."
  type        = string
  default     = "SSH private key (PEM) generated by Terraform."
}

variable "recovery_window_in_days" {
  description = "SSM scheduled-deletion window. 0 = delete immediately on destroy; 1-30 = retain that many days (recoverable)."
  type        = number
  default     = 0
}

variable "kms_key_id" {
  description = "Optional KMS CMK id to encrypt the SSM secret. Empty = SSM's default CMK."
  type        = string
  default     = ""
}

variable "tags" {
  description = "Tags applied to the SSM secret."
  type        = map(string)
  default     = {}
}
